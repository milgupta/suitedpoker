# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local env
.env
.env.local
.env*.local

# test output
coverage/
playwright-report/
test-results/

# solver pipeline output (large, regenerable)
tools/solver/out/

# build info
*.tsbuildinfo

# Sync-conflict duplicates. A file-sync client (iCloud/Dropbox on ~/Desktop)
# copies files mid-write as "name 2.ts", "postflop 2/", "name 3.json". They are
# stale, tsconfig's **/*.ts glob typechecks them, and `git add -A` will commit
# them. Ignore rather than discover them in a diff.
* [0-9].*
* [0-9]/
